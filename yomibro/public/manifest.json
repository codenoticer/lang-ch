{
  "manifest_version": 3,
  "name": "Yomibro Hello",
  "version": "1.0.0",
  "description": "My first Chrome extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ]
}
